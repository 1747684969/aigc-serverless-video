# ============================================================
# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# ---- Modal 配置 ----
# 你的 Volume 名（模型存放位置，约 26GB）
H3_VOLUME_NAME=h3-model-volume

# 云端 GPU 型号：A100-40GB / L40S / ...
H3_GPU=A100-40GB

# 热容器保活秒数（连续出片建议 300-600；出一片就走建议 30-60）
H3_SCALEDOWN=120

# ---- 端点鉴权（强烈建议开启）----
# 1) modal secret create h3-endpoint-token H3_ENDPOINT_TOKEN=<随机长字符串>
# 2) 把这里设为 1，并让客户端带上 X-Auth-Token 头
H3_REQUIRE_AUTH=0
H3_ENDPOINT_TOKEN=

# ---- 本地节点使用的端点地址 ----
# 填写 `modal deploy modal/comfy_endpoint.py` 输出的地址
MODAL_H3_URL=https://<your-workspace>--comfy-h3-serverless-generate.modal.run
